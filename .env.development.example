# Development Environment Configuration
NODE_ENV="your_node_env_here"
PORT="your_port_here"

# Local Database URLs (for development)
MONGODB_URI="your_mongodb_uri_here"

POSTGRES_URI="your_postgres_uri_here"
REDIS_URL="your_redis_url_here"

# Development API Keys (use test keys)
BHASHINI_API_KEY="your_bhashini_api_key_here"
BHASHINI_BASE_URL="your_bhashini_base_url_here"

# Translation Fallback Configuration
TRANSLATION_FALLBACK_ENABLED="your_translation_fallback_enabled_here"
FALLBACK_TRANSLATION_SERVICE="your_fallback_translation_service_here"
FALLBACK_TRANSLATION_API_KEY="your_fallback_translation_api_key_here"

# OpenAI API Key (for voice processing - optional in development)
AI_INTEGRATIONS_OPENAI_API_KEY="your_ai_integrations_openai_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"

# TTS Configuration (development settings)
TTS_MODEL="your_tts_model_here"
VOICE_CLONING_ENABLED="your_voice_cloning_enabled_here"
AUDIO_CACHE_TTL="your_audio_cache_ttl_here"

# Development Security (not for production!)
JWT_SECRET="your_jwt_secret_here"
BCRYPT_ROUNDS="your_bcrypt_rounds_here"

# Development Business Logic
NEGOTIATION_TTL="your_negotiation_ttl_here"
STOCK_LOCK_TTL="your_stock_lock_ttl_here"
QR_SESSION_TTL="your_qr_session_ttl_here"
